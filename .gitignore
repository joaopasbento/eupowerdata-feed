# macOS Finder metadata
.DS_Store
# Python bytecode
__pycache__/
# Temp files of interrupted atomic writes (see write_json in fetch_entsoe.py)
*.tmp
# Wrangler's local state and Node packages (scheduler/)
.wrangler/
node_modules/
# Local secrets: environment files and Wrangler's local secrets (scheduler/)
.env
.dev.vars
# Answers of ENTSO-E saved by fetch_records.py --sample when run locally
samples/
# The Pro files of the price history (each zone's years, the daily means): kept in
# the private R2 bucket eupowerdata-pro, never in this public repository (see
# r2_price_history.sh). index.json and monthly.json stay public.
data/price-history/*/
